APP_NAME="OSCA Senior Citizen System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────────────
# RECOMMENDED (multi-device): Point all devices at the same remote MySQL server
# so ML results, cluster assignments, and risk scores are shared automatically.
#
#   DB_HOST=<your-server-ip-or-hostname>   e.g. 192.168.1.100 or db.yourdomain.com
#   DB_PORT=3306
#   DB_DATABASE=osca_db
#   DB_USERNAME=osca_user
#   DB_PASSWORD=<strong-password>
#
# LOCAL (single device / demo only):
#   DB_HOST=127.0.0.1  — each laptop has its own database.
#   New seniors added on one laptop will NOT appear on the other until you
#   manually export and import the ml_results table.
#
# After changing DB_HOST, restart Flask services so they reconnect:
#   python\venv\Scripts\python.exe python\services\inference_service.py
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osca_db
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache / Queue ────────────────────────────────────────────────────
# QUEUE_CONNECTION must be "database" — using "sync" causes batch ML
# analysis to block the HTTP request for minutes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@osca.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ── Python ML Services ─────────────────────────────────────────────────────────
# PYTHON_SERVICE_URL: base URL only — do NOT include a port number.
#   Ports are appended automatically: 5001 (preprocess), 5002 (inference).
PYTHON_SERVICE_URL=http://127.0.0.1

# PYTHON_PREPROCESS_PORT / PYTHON_INFERENCE_PORT: override only if another
#   process is already using these ports on your machine.
PYTHON_PREPROCESS_PORT=5001
PYTHON_INFERENCE_PORT=5002

# ML_MODELS_PATH: path to the trained .pkl / .json model files.
#   Relative paths are resolved from the project root.
ML_MODELS_PATH=python/models

# ENABLE_NOTEBOOK_OVERRIDES: Set to "true". When enabled, the inference service
#   reads composite_risk, cluster_id, and risk_level from
#   python/models/predictions/senior_predictions.csv for the 283 seed seniors,
#   reproducing the exact notebook output (HIGH=54, MODERATE=191, LOW=38).
#   New seniors added after seeding are scored live by the GBR/RFR models.
#   The CSV is gitignored — copy it from osca_output/predictions/ before seeding.
ENABLE_NOTEBOOK_OVERRIDES=true

# PYTHON_EXECUTABLE: override the Python binary used for local subprocess
#   fallback (Tier 2). Leave blank to auto-detect from python/venv.
# PYTHON_EXECUTABLE=

# PYTHON_TIMEOUT: seconds to wait for a Python subprocess response (Tier 2).
#   Increase if seeding times out on a slow machine.
PYTHON_TIMEOUT=120

# ── Municipality ───────────────────────────────────────────────────────────────
# Used in OSCA ID generation and PDF report headers.
MUNICIPALITY_NAME="Pagsanjan"
PROVINCE_NAME="Laguna"
