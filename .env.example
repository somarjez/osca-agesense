APP_NAME="OSCA Senior Citizen System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────────────
#
# ┌─────────────────────────────────────────────────────────────────┐
# │  TEAM / DEFENSE SETUP — choose ONE of the two modes below:     │
# └─────────────────────────────────────────────────────────────────┘
#
# MODE 1 ─ Shared Remote MySQL (RECOMMENDED for final defense)
# ─────────────────────────────────────────────────────────────
#   All devices point at the same MySQL server hosted on one laptop
#   (or a cloud host). Everyone sees identical data in real time.
#
#   Steps:
#     1. On the host laptop, run ipconfig and note its IPv4 address.
#     2. In MySQL on the host, create a remote user:
#          CREATE USER 'osca_user'@'%' IDENTIFIED BY 'StrongPass!';
#          GRANT ALL PRIVILEGES ON osca_db.* TO 'osca_user'@'%';
#          FLUSH PRIVILEGES;
#     3. Open port 3306 in Windows Firewall (as Administrator):
#          New-NetFirewallRule -DisplayName "MySQL" -Direction Inbound `
#            -Protocol TCP -LocalPort 3306 -Action Allow
#     4. In MySQL's my.ini, set or comment out bind-address:
#          bind-address = 0.0.0.0
#        Then restart MySQL: Restart-Service -Name "MySQL*"
#     5. On every other device, set these values in .env:
#
#   DB_HOST=<host-laptop-IPv4>    e.g. 192.168.1.100
#   DB_DATABASE=osca_db
#   DB_USERNAME=osca_user
#   DB_PASSWORD=StrongPass!
#
#   After changing DB_HOST, clear config cache and restart Flask:
#     php artisan config:clear
#     (restart python/services/inference_service.py)
#
# MODE 2 ─ Local MySQL + Shared Database Dump (offline / backup)
# ──────────────────────────────────────────────────────────────
#   Main laptop exports a validated dump; other devices import it.
#   See docs/DATABASE_SHARING.md for full export/import steps.
#
#   DB_HOST=127.0.0.1   ← each laptop has its own local database
#   DB_DATABASE=osca_db
#   DB_USERNAME=root
#   DB_PASSWORD=
#
# ─────────────────────────────────────────────────────────────────
# WARNING: Do NOT commit real database dumps to GitHub.
#          Personal senior citizen data is sensitive.
#          Keep dumps in database/backups/ (gitignored).
# ─────────────────────────────────────────────────────────────────
# ── Copy one of the blocks below into the active section ──────────────────────

# Shared Remote MySQL Setup
# Use this for final team testing or defense. All devices point at the same host.
# DB_CONNECTION=mysql
# DB_HOST=<shared_mysql_host_or_ip>
# DB_PORT=3306
# DB_DATABASE=osca_db
# DB_USERNAME=agesense_user
# DB_PASSWORD=<password>

# Local Development Setup
# Use this only for individual development/testing (not official results).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=osca_db
# DB_USERNAME=root
# DB_PASSWORD=

# ── Active database config (edit these values) ────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osca_db
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache / Queue ────────────────────────────────────────────────────
# QUEUE_CONNECTION must be "database" — using "sync" causes batch ML
# analysis to block the HTTP request for minutes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@osca.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ── Python ML Services ─────────────────────────────────────────────────────────
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  ML SERVICE QUICK-START                                                     │
# │                                                                             │
# │  1. Start preprocess service (port 5001):                                   │
# │       python/venv/Scripts/python.exe python/services/preprocess_service.py  │
# │                                                                             │
# │  2. Start inference service (port 5002):                                    │
# │       python/venv/Scripts/python.exe python/services/inference_service.py   │
# │                                                                             │
# │  3. Validate artifact bundle:                                               │
# │       python/venv/Scripts/python.exe python/scripts/validate_model_artifacts.py  │
# │                                                                             │
# │  4. Run reproducibility test:                                               │
# │       python/venv/Scripts/python.exe python/scripts/test_reproducibility.py │
# └─────────────────────────────────────────────────────────────────────────────┘

# PYTHON_SERVICE_URL: base URL only — do NOT include a port number.
#   Ports are appended automatically: 5001 (preprocess), 5002 (inference).
PYTHON_SERVICE_URL=http://127.0.0.1

# PYTHON_PREPROCESS_PORT / PYTHON_INFERENCE_PORT: override only if another
#   process is already using these ports on your machine.
PYTHON_PREPROCESS_PORT=5001
PYTHON_INFERENCE_PORT=5002

# ── Canonical model path ───────────────────────────────────────────────────────
#
# ML_MODELS_PATH: path to the trained .pkl / .json artifact bundle.
#   Relative paths are resolved from the project root (osca-system/).
#   Canonical value: python/models (never change this without re-running the
#   artifact validation script — see docs/ML_DEPLOYMENT.md).
#
#   Required files in this directory:
#     scaler.pkl              — StandardScaler fitted on 39 features / 283 seniors
#     umap_nd.pkl             — UMAP fitted on 31 post-VIF features → 10 components
#     kmeans.pkl              — KMeans (k=3) fitted on UMAP embeddings
#     feature_list.json       — 31-feature list (UMAP input, post-VIF subset)
#     cluster_mapping.json    — raw KMeans IDs to named cluster IDs: {0→3,1→1,2→2}
#     gbr_ic.pkl etc.         — GBR/RFR ensemble models for IC/ENV/FUNC risk
#     cluster_metadata.json   — human-readable cluster descriptions
#     ml_risk_features.json   — 51-feature list for ensemble risk models
#     vif_retained_features.json — VIF analysis output (informational)
#
#   If you have storage/app/ml_models/ it must be a copy of python/models/.
#   Run validate_model_artifacts.py to confirm both directories are in sync.
#
ML_MODELS_PATH=python/models

# ── Prediction source control ──────────────────────────────────────────────────
#
# ENABLE_NOTEBOOK_OVERRIDES controls which path the inference service uses
# for the 283 seniors who were seeded from the training notebook (osca5.ipynb).
#
#   true  (RECOMMENDED for demo/defense):
#     The inference service reads composite_risk, cluster_id, and risk_level
#     directly from python/models/predictions/senior_predictions.csv for any
#     senior already in ml_results with prediction_source='notebook_cache'.
#     This guarantees the 283 seed seniors always show the validated notebook
#     distribution: HIGH=54, MODERATE=191, LOW=38.
#     New seniors added after seeding are still scored live by the GBR/RFR models.
#
#   false (for live-model testing only):
#     Every senior, including the 283 seeded ones, is scored live through
#     scaler → UMAP → KMeans → GBR/RFR. Use this only when testing the live
#     pipeline; results may differ from notebook output due to floating-point
#     differences in UMAP's approximate nearest-neighbour search.
#
#   The CSV (senior_predictions.csv) is gitignored.
#   Copy it from osca_output/predictions/ to python/models/predictions/ before seeding.
#
ENABLE_NOTEBOOK_OVERRIDES=true

# ── UMAP determinism (threading) ──────────────────────────────────────────────
#
# UMAP uses numba JIT compilation internally. Without these settings, UMAP's
# approximate nearest-neighbour search is non-deterministic across CPUs and
# thread counts, producing different embeddings — and therefore different
# cluster assignments and risk levels — for the same input on different machines.
#
# These variables force single-threaded mode so transform() is reproducible.
# They are set programmatically at the top of inference_service.py via
# os.environ.setdefault(), so they only need to be listed here if you want
# to override them for a specific environment.
#
# NUMBA_THREADING_LAYER=workqueue
# NUMBA_NUM_THREADS=1
# OMP_NUM_THREADS=1

# ── Subprocess fallback (Tier 2) ───────────────────────────────────────────────
# PYTHON_EXECUTABLE: override the Python binary used for local subprocess
#   fallback (Tier 2). Leave blank to auto-detect from python/venv.
# PYTHON_EXECUTABLE=

# PYTHON_TIMEOUT: seconds to wait for a Python subprocess response (Tier 2).
#   Increase if seeding times out on a slow machine.
PYTHON_TIMEOUT=120

# ── Municipality ───────────────────────────────────────────────────────────────
# Used in OSCA ID generation and PDF report headers.
MUNICIPALITY_NAME="Pagsanjan"
PROVINCE_NAME="Laguna"
