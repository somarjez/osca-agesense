APP_NAME="OSCA Senior Citizen System"
#
# ┌─────────────────────────────────────────────────────────────────┐
# │  PRODUCTION WARNING — the three values below are LOCAL DEFAULTS │
# └─────────────────────────────────────────────────────────────────┘
#
# APP_ENV=local, APP_DEBUG=true, and LOG_LEVEL=debug are this team's
# local/defense-day setup — intentionally left as-is here so every
# developer copying this file gets a working local environment.
#
# A REAL PRODUCTION deployment MUST override all three:
#   APP_ENV=production
#   APP_DEBUG=false
#   LOG_LEVEL=error   (or warning)
#
# Reason: with APP_DEBUG=true, unhandled errors render full stack
# traces — file paths, query bindings, env values — straight to the
# browser. That is a direct information-disclosure risk for anyone
# who can reach the site. Never run a public/production instance with
# APP_DEBUG=true.
#
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────────────
#
# ┌─────────────────────────────────────────────────────────────────┐
# │  TEAM / DEFENSE SETUP — choose ONE of the two modes below:     │
# └─────────────────────────────────────────────────────────────────┘
#
# MODE 1 ─ Shared Remote MySQL (RECOMMENDED for final defense)
# ─────────────────────────────────────────────────────────────
#   All devices point at the same MySQL server hosted on one laptop
#   (or a cloud host). Everyone sees identical data in real time.
#
#   Steps:
#     1. On the host laptop, run ipconfig and note its IPv4 address.
#     2. In MySQL on the host, create a remote user:
#          CREATE USER 'osca_user'@'%' IDENTIFIED BY 'StrongPass!';
#          GRANT ALL PRIVILEGES ON osca_db.* TO 'osca_user'@'%';
#          FLUSH PRIVILEGES;
#     3. Open port 3306 in Windows Firewall (as Administrator):
#          New-NetFirewallRule -DisplayName "MySQL" -Direction Inbound `
#            -Protocol TCP -LocalPort 3306 -Action Allow
#     4. In MySQL's my.ini, set or comment out bind-address:
#          bind-address = 0.0.0.0
#        Then restart MySQL: Restart-Service -Name "MySQL*"
#     5. On every other device, set these values in .env:
#
#   DB_HOST=<host-laptop-IPv4>    e.g. 192.168.1.100
#   DB_DATABASE=osca_db
#   DB_USERNAME=osca_user
#   DB_PASSWORD=StrongPass!
#
#   After changing DB_HOST, clear config cache and restart Flask:
#     php artisan config:clear
#     (restart python/services/inference_service.py)
#
# MODE 2 ─ Local MySQL + Shared Database Dump (offline / backup)
# ──────────────────────────────────────────────────────────────
#   Main laptop exports a validated dump; other devices import it.
#   See docs/DATABASE_SHARING.md for full export/import steps.
#
#   DB_HOST=127.0.0.1   ← each laptop has its own local database
#   DB_DATABASE=osca_db
#   DB_USERNAME=root
#   DB_PASSWORD=
#
# ─────────────────────────────────────────────────────────────────
# WARNING: Do NOT commit real database dumps to GitHub.
#          Personal senior citizen data is sensitive.
#          Keep dumps in database/backups/ (gitignored).
# ─────────────────────────────────────────────────────────────────
# ── Copy one of the blocks below into the active section ──────────────────────

# Shared Remote MySQL Setup
# Use this for final team testing or defense. All devices point at the same host.
# DB_CONNECTION=mysql
# DB_HOST=<shared_mysql_host_or_ip>
# DB_PORT=3306
# DB_DATABASE=osca_db
# DB_USERNAME=agesense_user
# DB_PASSWORD=<password>

# Local Development Setup
# Use this only for individual development/testing (not official results).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=osca_db
# DB_USERNAME=root
# DB_PASSWORD=

# ── Active database config (edit these values) ────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osca_db
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache / Queue ────────────────────────────────────────────────────
# QUEUE_CONNECTION must be "database" — using "sync" causes batch ML
# analysis to block the HTTP request for minutes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@osca.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ── Python ML Services ─────────────────────────────────────────────────────────
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  ML SERVICE QUICK-START                                                     │
# │                                                                             │
# │  1. Start preprocess service (port 5001):                                   │
# │       python/venv/Scripts/python.exe python/services/preprocess_service.py  │
# │                                                                             │
# │  2. Start inference service (port 5002):                                    │
# │       python/venv/Scripts/python.exe python/services/inference_service.py   │
# │                                                                             │
# │  3. Validate artifact bundle:                                               │
# │       python/venv/Scripts/python.exe python/scripts/validate_model_artifacts.py  │
# │                                                                             │
# │  4. Run reproducibility test:                                               │
# │       python/venv/Scripts/python.exe python/scripts/test_reproducibility.py │
# └─────────────────────────────────────────────────────────────────────────────┘

# PYTHON_SERVICE_URL: base URL only — do NOT include a port number.
#   Ports are appended automatically: 5001 (preprocess), 5002 (inference).
PYTHON_SERVICE_URL=http://127.0.0.1

# PYTHON_PREPROCESS_PORT / PYTHON_INFERENCE_PORT: override only if another
#   process is already using these ports on your machine.
PYTHON_PREPROCESS_PORT=5001
PYTHON_INFERENCE_PORT=5002

# ML_SERVICE_TOKEN: shared secret sent by Laravel as the X-Internal-Api-Key
#   header on every preprocess/infer/batch_preprocess/batch_infer request, and
#   checked by both Flask services (preprocess_service.py, inference_service.py)
#   before dispatching. Must be set to the SAME value here and in the
#   environment the Flask services run under — Laravel and Flask read this
#   exact variable name, so a mismatch (not a blank) will lock out real traffic.
#   Leaving it blank disables auth enforcement on both sides: fine for local
#   dev on a trusted machine, not recommended once the services are reachable
#   from anywhere else (e.g. the LAN "Shared Remote MySQL" defense-day setup).
ML_SERVICE_TOKEN=

# ── Canonical model path ───────────────────────────────────────────────────────
#
# ML_MODELS_PATH: path to the trained .pkl / .json artifact bundle.
#   Relative paths are resolved from the project root (osca-system/).
#   Canonical value: python/models (never change this without re-running the
#   artifact validation script — see docs/ML_DEPLOYMENT.md).
#
#   Required files in this directory:
#     scaler.pkl              — StandardScaler fitted on 39 features / 283 seniors
#     umap_nd.pkl             — UMAP fitted on 31 post-VIF features → 10 components
#     kmeans.pkl              — KMeans (k=3) fitted on UMAP embeddings
#     feature_list.json       — 31-feature list (UMAP input, post-VIF subset)
#     cluster_mapping.json    — raw KMeans IDs to named cluster IDs: {0→3,1→1,2→2}
#     gbr_ic.pkl etc.         — GBR/RFR ensemble models for IC/ENV/FUNC risk
#     cluster_metadata.json   — human-readable cluster descriptions
#     ml_risk_features.json   — 51-feature list for ensemble risk models
#     vif_retained_features.json — VIF analysis output (informational)
#
#   If you have storage/app/ml_models/ it must be a copy of python/models/.
#   Run validate_model_artifacts.py to confirm both directories are in sync.
#
ML_MODELS_PATH=python/models

# ── Prediction source control ──────────────────────────────────────────────────
#
# ENABLE_NOTEBOOK_OVERRIDES controls whether the inference service substitutes
# notebook-cached predictions for seniors seeded from osca5.ipynb.
#
#   false (RECOMMENDED — deployed default):
#     Every senior is scored live through the trained deterministic pipeline:
#       scaler → KNN k=5 cluster classifier (→ nearest-centroid fallback) → GBR/RFR risk models.
#     prediction_source is stamped 'live_model'. Clustering is deterministic across
#     devices (pinned deps + SHA-256 artifact manifest) — NOT dependent on UMAP's
#     approximate nearest-neighbour search (UMAP only runs when
#     ENABLE_DETERMINISTIC_CLUSTER=false, which is for debug only).
#     KNN cluster CV accuracy: 0.9333; agreement with notebook labels: ~92.8%.
#     Risk-level agreement with notebook: ~99.4%.
#
#   true  (optional — demo/defense reproducibility mode):
#     For seeded seniors already in ml_results, the inference service reads
#     composite_risk, cluster_id, risk_level, and recommendations directly from
#     python/models/predictions/senior_predictions.csv, reproducing the exact
#     notebook distribution: HIGH=54, MODERATE=191, LOW=38.
#     New seniors (not in the CSV) still fall through to live scoring.
#     Useful when you need bit-for-bit notebook reproduction for a defense demo.
#     After switching to true, run: php artisan ml:batch-analyze --force
#
#   The CSV (senior_predictions.csv) is gitignored.
#   Copy it from osca_output/predictions/ to python/models/predictions/ before seeding.
#   Restart Flask services after changing this flag (python/start_services.ps1).
#
ENABLE_NOTEBOOK_OVERRIDES=false

# ── Cross-device deterministic cluster assignment ──────────────────────────────
#
# ENABLE_DETERMINISTIC_CLUSTER controls how new seniors (not yet in the DB cache)
# get their cluster assigned when analyzed on a fresh device.
#
#   false (DEFAULT — safe):
#     Live UMAP transform assigns the cluster. Result may differ slightly from
#     another device due to OS/BLAS/hardware non-determinism in UMAP, until the
#     DB cache synchronises the result across devices.
#
#   true (RECOMMENDED for multi-device teams):
#     Cluster is assigned by nearest L2 distance to pre-computed centroids in
#     the scaled feature space — pure arithmetic, identical on every platform.
#     Requires python/models/cluster_centroids_scaled.json to exist (run
#     generate_cluster_centroids.py once to produce it).
#     Falls back to live UMAP automatically if the JSON file is absent.
#     NOTE: Restart the Flask inference service after generating the centroids
#     file or after changing this flag — both are captured at service startup
#     (lru_cache + module-level constant).
#
ENABLE_DETERMINISTIC_CLUSTER=false

# ── UMAP determinism (threading) ──────────────────────────────────────────────
#
# UMAP uses numba JIT compilation internally. Without these settings, UMAP's
# approximate nearest-neighbour search is non-deterministic across CPUs and
# thread counts, producing different embeddings — and therefore different
# cluster assignments and risk levels — for the same input on different machines.
#
# These variables force single-threaded mode so transform() is reproducible.
# They are set programmatically at the top of inference_service.py via
# os.environ.setdefault(), so they only need to be listed here if you want
# to override them for a specific environment.
#
# NUMBA_THREADING_LAYER=workqueue
# NUMBA_NUM_THREADS=1
# OMP_NUM_THREADS=1

# ── Subprocess fallback (Tier 2) ───────────────────────────────────────────────
# PYTHON_EXECUTABLE: override the Python binary used for local subprocess
#   fallback (Tier 2). Leave blank to auto-detect from python/venv.
# PYTHON_EXECUTABLE=

# PYTHON_TIMEOUT: seconds to wait for a Python subprocess response (Tier 2).
#   Increase if seeding times out on a slow machine.
PYTHON_TIMEOUT=120

# ── Municipality ───────────────────────────────────────────────────────────────
# Used in OSCA ID generation and PDF report headers.
MUNICIPALITY_NAME="Pagsanjan"
PROVINCE_NAME="Laguna"

# GIS routing: optional OpenRouteService key for road-network distance/time.
# If blank, GIS popups fall back to public OSRM routing.
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.heigit.org/openrouteservice
OPENROUTESERVICE_CA_BUNDLE=
OPENROUTESERVICE_VERIFY_SSL=true
# Live popup routing — kept short so the map UI never hangs on a cache miss.
OPENROUTESERVICE_SNAP_RADIUS_METERS=-1
OPENROUTESERVICE_CONNECT_TIMEOUT=3
OPENROUTESERVICE_TIMEOUT=5
OPENROUTESERVICE_RETRY_TIMES=0
OPENROUTESERVICE_RETRY_SLEEP_MS=500
# Background precompute (gis:cache-route-distances) — patient + retried so the
# ORS free tier's variable latency doesn't time out into the OSRM fallback.
OPENROUTESERVICE_BATCH_CONNECT_TIMEOUT=15
OPENROUTESERVICE_BATCH_TIMEOUT=40
OPENROUTESERVICE_BATCH_RETRY_TIMES=2
OPENROUTESERVICE_BATCH_RETRY_SLEEP_MS=2000
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_CONNECT_TIMEOUT=3
OSRM_TIMEOUT=8
# OSRM batch fallback (gis:cache-route-distances --osrm-on-quota) — the public
# OSRM demo is slow, so allow more time + retries here.
OSRM_BATCH_CONNECT_TIMEOUT=15
OSRM_BATCH_TIMEOUT=45
OSRM_BATCH_RETRY_TIMES=2
OSRM_BATCH_RETRY_SLEEP_MS=2000
