# Sensitive data — never commit
*.sql
osca.csv
python/models/predictions/senior_predictions.csv
python/models/predictions/senior_recommendations_flat.csv

# Database dumps — contain personal senior citizen data, never commit
database/backups/*.sql
database/backups/*.dump
database/backups/*.gz
database/backups/*.zip

# Laravel / PHP
/.phpunit.cache
/.phpunit.result.cache
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*.php
.env
.env.backup
.env.production
auth.json
Homestead.json
Homestead.yaml
composer.phar

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/

# Project-local Python service artifacts
python/.venv/
python/__pycache__/
python/**/*.pyc
python/logs/
python/tmp/
python/services/*_err.txt
python/services/out_*.json
python/services/err_*.txt

# Temporary ML pipeline output files (generated by Laravel local-subprocess mode)
storage/app/ml_err_*.txt
storage/app/ml_out_*.json

# ML model binary artifacts — canonical source is python/models/, not storage/
# The .pkl and .json files in storage/app/ml_models/ are runtime mirror copies
# and must not be committed. Copy them from python/models/ on each device.
storage/app/ml_models/*.pkl
storage/app/ml_models/*.json

# ML validation output — may contain senior PII (names, barangay), never commit
storage/app/ml_validation/

# Laravel runtime directories — generated at startup, never commit
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/

# Backup files created during artifact sync operations — never commit
*.bak
*.bak_old

# IDE / editor
/.fleet
/.idea
/.vscode

# OS files
.DS_Store
Thumbs.db
